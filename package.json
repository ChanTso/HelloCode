{
  "name": "hellocode-agent",
  "version": "0.2.0",
  "description": "A small, practical coding agent for your terminal.",
  "type": "module",
  "bin": {
    "hellocode": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src test --no-error-on-unmatched-pattern --max-warnings=0",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepare": "npm run build"
  },
  "keywords": [
    "coding-agent",
    "claude",
    "cli",
    "openai",
    "typescript"
  ],
  "author": "ChanTso",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChanTso/HelloCode.git"
  },
  "bugs": {
    "url": "https://github.com/ChanTso/HelloCode/issues"
  },
  "homepage": "https://github.com/ChanTso/HelloCode#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "openai": "^7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
